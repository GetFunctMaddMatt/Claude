# Godot 4 generated cache -- safe to ignore, regenerated automatically
.godot/

# Per-file import metadata -- regenerated by Godot on import
*.import
*.remap

# Export artifacts
export/
*.apk
*.aab
*.ipa
*.pck
*.zip

# OS
.DS_Store
Thumbs.db

# NOTE: Do NOT ignore *.uid files.
# Godot 4.4+ uses them to track resource identity across renames/moves.
# Commit them alongside their parent file.
